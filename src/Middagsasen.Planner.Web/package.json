{
  "name": "middagsasen-planner-web",
  "version": "0.0.1",
  "description": "Planlegger for Middagsåsen",
  "productName": "Middagsåsen Bemanning",
  "author": "Christoffer Cena <chris+github@cenaonline.net>",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint --ext .js,.ts,.vue ./",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .prettierignore",
    "typecheck": "vue-tsc --noEmit",
    "gen:api": "openapi-typescript ../Middagsasen.Planner.Api/openapi/openapi.json -o src/types/api.d.ts && node scripts/gen-api-aliases.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@date-fns/utc": "^2.1.0",
    "@quasar/extras": "^1.16.17",
    "@quasar/quasar-ui-qcalendar": "^5.3.1",
    "@timestamp-js/core": "^1.0.0",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "@vuepic/vue-datepicker": "^12.1.0",
    "axios": "^1.2.1",
    "chart.js": "^4.4.6",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^2.30.0",
    "pinia": "^2.0.11",
    "quasar": "^2.18.1",
    "vue": "^3.0.0",
    "vue-chartjs": "^5.3.2",
    "vue-i18n": "^9.0.0",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^5.2.0",
    "@quasar/app-vite": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.2",
    "eslint": "^8.10.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-vue": "^9.0.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.14",
    "prettier": "^2.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=22.13",
    "npm": ">= 10.8.2"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
