# Normaliser alle tekstfiler til LF i repoet og i arbeidskopien,
# uavhengig av core.autocrlf. Formatereren (oxfmt) forventer LF.
* text=auto eol=lf

# Windows-spesifikke filer som verktøyene forventer med CRLF i arbeidskopien
# (lagres fortsatt som LF i repoet)
*.sln   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Shell-skript må alltid ha LF
*.sh    text eol=lf

# Binære filer
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.zip   binary
*.dll   binary
*.exe   binary
*.dacpac binary
*.db    binary
*.db-shm binary
*.db-wal binary
*.suo   binary
